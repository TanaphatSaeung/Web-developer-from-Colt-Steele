<% layout('./layouts/boilerplate') %>
<h1>Login</h1>
<form action="/login" method="POST" novalidate class="needs-validation">
    <div class="mb-3">
        <label class="form-label" for="title">Username</label>
        <input
          class="form-control"
          type="text"
          id="username"
          name="username"
          required
        />
        <div class="valid-feedback">
          Looks good!
        </div>
        <div class="invalid-feedback">
          Username is required
        </div>
      </div>
    </div>
        <label class="form-label" for="title">Password</label>
        <input
          class="form-control"
          type="password"
          id="password"
          name="password"
          required
        />
        <div class="valid-feedback">
          Looks good!
        </div>
        <div class="invalid-feedback">
          Password is required
        </div>
      </div>
    <button class="mt-3 btn btn-success">Login</button>
</form>