<% layout('./layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/star.css">
<div class="row mb-3">
  <div class="col-6">
    <div class="card mb-3" style="width: 38vw">    
      <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <% if (campgrounds.images.length > 1) { %>
            <% campgrounds.images.forEach((img,i) => { %>
              <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="<%= i %>" class="<%= i === 0? 'active':'' %>" <%= i === 0 ? 'aria-current="true"' : '' %> aria-label="Slide <%= i+1%>"></button>
            <% }) %>
          <% } %>
        </div>
        <div class="carousel-inner">
          <% campgrounds.images.forEach((img,i) => { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <img src="<%= img.detail %>" class="d-block w-100" alt="<%= img._id %>">
            </div>
          <% }) %>
        </div>
        <% if (campgrounds.images.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
        <% } %>
      </div>
      
      <div class="card-body">
        <h5 class="card-title"><%= campgrounds.title %></h5>
        <p class="card-text"><%= campgrounds.description %></p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item text-muted"><%= campgrounds.location %></li>
        <li class="list-group-item">Submitted By: <%= campgrounds.author.username %></li>
        <li class="list-group-item">$<%= campgrounds.price %> /night</li>
      </ul>
      <% if(currentUser && campgrounds.author.equals(currentUser._id)) { %>
      <div class="card-body d-flex justify-content-between">
          <a class="card-link btn btn-primary" href="/campground/<%= campgrounds._id %>/edit">Edit</a>
          <form
          action="/campground/<%= campgrounds._id %>?_method=DELETE"
          method="post"
          >
          <button class="btn btn-danger">Delete</button> <br />
        </form>
      </div>
      <% } %>
      <div class="card-footer text-muted">
        2 days ago
      </div>
      </div>
    </div>
    <div class="col-6 mb-3">
      <% if (currentUser) { %>
      <h2>Leave a Review</h2>
      <form action="/campground/<%= campgrounds._id %>/reviews" method="POST" novalidate class="needs-validation mb-3" >
          <div class="mb-3">
            <fieldset class="starability-coinFlip" required>
              <legend class="form-label" for="rating">Rating</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="reviews[rating]" id="rating" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="reviews[rating]" id="rating" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="reviews[rating]" id="rating" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="reviews[rating]" id="rating" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="reviews[rating]" id="rating" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="reviews[rating]" id="rating" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label class="form-label" for="body">Review</label>
            <textarea class="form-control" name="reviews[body]" id="body" rows="3" required></textarea>
            <div class="valid-feedback">
              Looks good!
            </div>
          </div>
          <button class="btn btn-success" >Submit</button>
      </form>
      <% } %>
          <% for (review of campgrounds.reviews){ %>
          <div class="card mb-3">
            <div class="card-body">
              <h6 class="card-subtitle mb-2 text-muted"><b><%= review.author.username %></b></h6>
              <p class="starability-result" data-rating="<%= review.rating %>"></p>
              
              <p>Review: <%= review.body %></p>
              <% if (currentUser && review.author.equals(currentUser._id) ) { %>
              <form action="/campground/<%= campgrounds._id %>/reviews/<%= review.id %>?_method=DELETE" method="post">
                <button class="btn btn-sm btn-danger">delete</button>
              </form>
              <% } %>
            </div>
          </div>
          <% } %>
    </div>
</div>
